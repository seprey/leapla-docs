{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Leapla",
  "description": "How Leapla works: your day, your business and what you share, in one place.",
  "colors": {
    "primary": "#111111",
    "light": "#F2F2F2",
    "dark": "#111111"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 600,
      "source": "/fonts/sora-latin-600.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://leapla.co"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "navbar": {
          "links": [
            {
              "label": "leapla.co",
              "href": "https://leapla.co"
            }
          ],
          "primary": {
            "type": "button",
            "label": "Open the app",
            "href": "https://app.leapla.co"
          }
        },
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "getting-started"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "features/home",
              "features/inbox",
              "features/tasks",
              "features/calendar",
              "features/money",
              "features/papers",
              "features/docs",
              "features/shared",
              "features/apla"
            ]
          }
        ]
      },
      {
        "language": "nl",
        "navbar": {
          "links": [
            {
              "label": "leapla.co",
              "href": "https://leapla.co"
            }
          ],
          "primary": {
            "type": "button",
            "label": "Open de app",
            "href": "https://app.leapla.co"
          }
        },
        "groups": [
          {
            "group": "Begin hier",
            "pages": [
              "nl/index",
              "nl/getting-started"
            ]
          },
          {
            "group": "Onderdelen",
            "pages": [
              "nl/features/home",
              "nl/features/inbox",
              "nl/features/tasks",
              "nl/features/calendar",
              "nl/features/money",
              "nl/features/papers",
              "nl/features/docs",
              "nl/features/shared",
              "nl/features/apla"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/aan-de-slag",
      "destination": "/nl/getting-started"
    },
    {
      "source": "/onderdelen/home",
      "destination": "/nl/features/home"
    },
    {
      "source": "/onderdelen/inbox",
      "destination": "/nl/features/inbox"
    },
    {
      "source": "/onderdelen/taken",
      "destination": "/nl/features/tasks"
    },
    {
      "source": "/onderdelen/agenda",
      "destination": "/nl/features/calendar"
    },
    {
      "source": "/onderdelen/geld",
      "destination": "/nl/features/money"
    },
    {
      "source": "/onderdelen/papieren",
      "destination": "/nl/features/papers"
    },
    {
      "source": "/onderdelen/docs",
      "destination": "/nl/features/docs"
    },
    {
      "source": "/onderdelen/gedeeld",
      "destination": "/nl/features/shared"
    },
    {
      "source": "/onderdelen/apla",
      "destination": "/nl/features/apla"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "leapla.co",
        "href": "https://leapla.co"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open de app",
      "href": "https://app.leapla.co"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  }
}
