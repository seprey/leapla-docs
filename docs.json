{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Leapla",
  "description": "Hoe Leapla werkt: je dag, je bedrijf en wat je deelt, op één plek.",
  "colors": {
    "primary": "#111111",
    "light": "#F2F2F2",
    "dark": "#111111"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 600,
      "source": "/fonts/sora-latin-600.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://leapla.co"
  },
  "navigation": {
    "languages": [
      {
        "language": "nl",
        "groups": [
          {
            "group": "Begin hier",
            "pages": [
              "index",
              "aan-de-slag"
            ]
          },
          {
            "group": "Onderdelen",
            "pages": [
              "onderdelen/home",
              "onderdelen/inbox",
              "onderdelen/taken",
              "onderdelen/agenda",
              "onderdelen/geld",
              "onderdelen/papieren",
              "onderdelen/docs",
              "onderdelen/gedeeld",
              "onderdelen/apla"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "leapla.co",
        "href": "https://leapla.co"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open de app",
      "href": "https://app.leapla.co"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  }
}
